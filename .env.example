# Arbiter environment template
# Copy to .env and fill in. Never commit .env.

# Chain
ARC_RPC_HTTP=https://rpc.testnet.arc.network
ARC_RPC_WS=wss://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# Deployer
# Funds the Phase 0 smoke-test deploy and Phase 1 ArbiterHook + InsurancePool deploys.
# Fund this wallet from https://faucet.circle.com (select Arc Testnet).
# USDC is Arc's native gas token, so the faucet drip pays for deploys directly.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_PUBLIC_ADDRESS=

# Contract addresses
# Filled after the Phase 1 deploy. The four pre-existing addresses below come
# from PLAN.md §4 and are already live on Arc Testnet.
ARBITER_HOOK_ADDRESS=
INSURANCE_POOL_ADDRESS=
USDC_ADDRESS=0x3600000000000000000000000000000000000000
JOB_CONTRACT_ADDRESS=0x0747EEf0706327138c69792bF28Cd525089e4583
IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
REPUTATION_REGISTRY_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713
VALIDATION_REGISTRY_ADDRESS=0x8004Cb1BF31DAf7788923b405b754f57acEB4272

# Coordinator
COORDINATOR_PRIVATE_KEY=
COORDINATOR_PUBLIC_ADDRESS=
DATABASE_URL=postgresql://arbiter:CHANGEME@postgres:5432/arbiter
REDIS_URL=redis://redis:6379

# LLM
# Confirm the exact model id against the Anthropic SDK before deploy.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Storage (Pinata IPFS)
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_GATEWAY_URL=

# Frontend (Next.js public envs)
NEXT_PUBLIC_API_URL=https://arbiter.market/api
NEXT_PUBLIC_WS_URL=wss://arbiter.market/ws
NEXT_PUBLIC_ARBITER_HOOK_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_CHAIN_ID=5042002

# Monitoring
SENTRY_DSN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Seed agents
# One private key + agent id per seeder service.
RESEARCH_AGENT_PRIVATE_KEY=
RESEARCH_AGENT_ID=

SENTIMENT_AGENT_PRIVATE_KEY=
SENTIMENT_AGENT_ID=

DATA_EXTRACT_AGENT_PRIVATE_KEY=
DATA_EXTRACT_AGENT_ID=

TRANSLATION_AGENT_PRIVATE_KEY=
TRANSLATION_AGENT_ID=

# Sponsor wallet
# Used by the daily seeding routine to post bounty jobs from a known address.
SPONSOR_PRIVATE_KEY=
SPONSOR_PUBLIC_ADDRESS=
